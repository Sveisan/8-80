{
  "name": "eight-and-eighty",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "audition": "npm run -w @8and80/voice audition --",
    "check": "npm run typecheck && npm run lint && npm run test",
    "checkurl": "npm run -w @8and80/voice checkurl",
    "control": "npm run -w @8and80/voice control",
    "db:generate": "npm run -w @8and80/voice db:generate",
    "db:migrate": "npm run -w @8and80/voice db:migrate",
    "lint": "eslint .",
    "models": "npm run -w @8and80/voice models",
    "preflight": "npm run -w @8and80/voice preflight",
    "prompt": "npm run -w @8and80/voice prompt",
    "replay": "npm run -w @8and80/voice replay",
    "runs": "npm run -w @8and80/voice runs",
    "serve": "npm run -w @8and80/voice serve",
    "stress": "npm run -w @8and80/voice stress",
    "test": "npm run -ws --if-present test",
    "tick": "npm run -w @8and80/voice tick",
    "typecheck": "npm run -ws --if-present typecheck",
    "voices": "npm run -w @8and80/voice voices --"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
