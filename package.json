{
  "name": "eight-and-eighty",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "quality:tips": "npm run -w @8and80/voice quality:tips --",
    "weekly:tools": "npm run -w @8and80/voice weekly:tools --",
    "beliefs:preview": "npm run -w @8and80/voice beliefs:preview",
    "animate-mark": "npm run -w @8and80/voice animate-mark",
    "audition": "npm run -w @8and80/voice audition --",
    "check": "npm run typecheck && npm run lint && npm run test",
    "checkurl": "npm run -w @8and80/voice checkurl",
    "control": "npm run -w @8and80/voice control",
    "db:generate": "npm run -w @8and80/voice db:generate",
    "db:migrate": "npm run -w @8and80/voice db:migrate",
    "deliveries": "npm run -w @8and80/voice deliveries --",
    "doctor": "npm run -w @8and80/voice doctor",
    "enrol": "npm run -w @8and80/voice enrol --",
    "lint": "eslint .",
    "models": "npm run -w @8and80/voice models",
    "preflight": "npm run -w @8and80/voice preflight",
    "numbers": "npm run -w @8and80/voice numbers",
    "prompt": "npm run -w @8and80/voice prompt",
    "speechify:sync": "npm run -w @8and80/voice speechify:sync --",
    "recap": "npm run -w @8and80/voice recap --",
    "replay": "npm run -w @8and80/voice replay",
    "runs": "npm run -w @8and80/voice runs",
    "serve": "npm run -w @8and80/voice serve",
    "stress": "npm run -w @8and80/voice stress",
    "test": "npm run -ws --if-present test",
    "test:db": "./scripts/test-with-db.sh",
    "tick": "bash scripts/tick-gated.sh",
    "typecheck": "npm run -ws --if-present typecheck",
    "voices": "npm run -w @8and80/voice voices --",
    "messages": "npm run -w @8and80/voice messages --",
    "journey": "npm run -w @8and80/voice journey",
    "beliefs:doctor": "npm run -w @8and80/voice beliefs:doctor",
    "beliefs:prompt": "npm run -w @8and80/voice beliefs:prompt --",
    "beliefs:requests": "npm run -w @8and80/voice beliefs:requests --",
    "quality:weekly": "npm run -w @8and80/voice quality:weekly --",
    "unblock:prompt": "npm run -w @8and80/voice unblock:prompt --",
    "unblock:chapters": "npm run -w @8and80/voice unblock:chapters --",
    "unblock:tools": "npm run -w @8and80/voice unblock:tools --"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
