{
  "openapi": "3.1.0",
  "info": {
    "title": "8&80 Beliefs capture tool",
    "version": "1.1.0",
    "description": "Provisional caller-owned capture. Server reconciles against signed completion transcript; never speak session credentials."
  },
  "servers": [
    {
      "url": "https://YOUR_PUBLIC_ORIGIN"
    }
  ],
  "paths": {
    "/beliefs/tool": {
      "post": {
        "operationId": "capture_belief",
        "summary": "Check caller words for a safety hold and stage a permitted Beliefs command",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "session_id",
                  "session_token",
                  "caller_text"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Per-call session_id dynamic variable"
                  },
                  "session_token": {
                    "type": "string",
                    "description": "Private per-call session_token dynamic variable; never spoken"
                  },
                  "event_id": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Stable unique ID for this save; required with a command"
                  },
                  "caller_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000,
                    "description": "Verbatim consecutive caller turns joined in order. No agent paraphrase."
                  },
                  "command": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "outcome"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "outcome"
                          },
                          "outcome": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "belief",
                          "trigger"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "queue"
                          },
                          "belief": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "trigger": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "ids",
                          "confirmed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "reorder"
                          },
                          "ids": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 50,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            }
                          },
                          "confirmed": {
                            "const": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "decision",
                          "evidence",
                          "balance",
                          "opportunity",
                          "confirmed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "prepare"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "decision": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "evidence": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 20,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            }
                          },
                          "balance": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "opportunity": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "confirmed": {
                            "const": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "confirmed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "understood"
                          },
                          "confirmed": {
                            "const": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "evidence",
                          "balance"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "practice"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "balance": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "passed": {
                            "const": false
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "passed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "practice"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "score",
                          "reflection",
                          "confirmed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "review"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "score": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10
                          },
                          "reflection": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "confirmed": {
                            "const": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "confirmed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "pause"
                          },
                          "confirmed": {
                            "const": true
                          }
                        }
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "command"
                      ]
                    },
                    "then": {
                      "required": [
                        "event_id"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Staged practice/IDs or held:true. Not proof of canonical persistence."
          },
          "401": {
            "description": "Invalid scoped session credential"
          },
          "409": {
            "description": "Invalid caller words, wrong call type, closed/stale session or changed account"
          },
          "413": {
            "description": "Request exceeds application body limit"
          }
        }
      }
    }
  }
}
