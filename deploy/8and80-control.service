# The control plane: webhooks in, reschedule page out.
#
#   sudo cp deploy/8and80-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now 8and80-control

[Unit]
Description=8&80 control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=eightandeighty
WorkingDirectory=/opt/8-80
EnvironmentFile=/opt/8-80/.env
ExecStart=/usr/bin/npm run control
Restart=always
RestartSec=5

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/opt/8-80/runs

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
