# One tick: ring whoever is due, then exit.
#
# A timer rather than a daemon with a sleep in it. A daemon that dies at three in
# the morning is a product that silently stops calling anybody; systemd
# restarting a one-shot is somebody else's solved problem.

[Unit]
Description=8&80 scheduler tick
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=eightandeighty
WorkingDirectory=/opt/8-80
EnvironmentFile=/opt/8-80/.env
ExecStart=/usr/bin/npm run tick

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
# The dash matters: runs/ is gitignored, so a fresh clone does not have it, and
# systemd refuses to start a unit whose ReadWritePaths does not exist —
# 226/NAMESPACE, which says nothing about a missing directory.
ReadWritePaths=-/opt/8-80/runs

# npm writes a debug log when a script fails, and everything else is read-only
# under ProtectSystem=strict. Without this the log write fails and hides the
# error it was written to explain.
Environment=NPM_CONFIG_CACHE=/opt/8-80/runs/.npm
Environment=NPM_CONFIG_UPDATE_NOTIFIER=false

StandardOutput=journal
StandardError=journal
