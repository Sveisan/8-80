# 8&80 — environment variables
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# NO VALUES IN THIS FILE — keys and documentation only, including defaults,
# which are described in comments rather than set here.
#
# Grouped by the milestone that first needs them. Keys below Milestone 0b are
# documented ahead of use so the shape of the config is visible; nothing reads
# them yet.

# ─────────────────────────────────────────────────────────────────────────────
# Milestone 0b — a call we can hear
# ─────────────────────────────────────────────────────────────────────────────

# --- Voice provider (behind the voice adapter) ---
# Which adapter to load. "grok" today; "openai" is the documented migration path.
VOICE_PROVIDER=
# xAI / SpaceXAI API key for Grok Voice Think Fast 2.0.
XAI_API_KEY=
# Speech-to-speech model id. Verify against current xAI docs before setting —
# do not assume a model id from memory.
XAI_VOICE_MODEL=
# The mentor's voice is the caller's choice. These map that choice onto provider
# voice names; the profile carries the choice itself. Unset falls back to
# XAI_VOICE_NAME, and unset again to the adapter default.
XAI_VOICE_FEMALE=
XAI_VOICE_MALE=
XAI_VOICE_NAME=

# --- What a caller said, at rest ---
# Application-layer encryption for commitments and, later, summaries. Before the
# database, not by it: disk encryption does not protect against a compromised
# application or an over-broad query. Without this set, nothing a caller said is
# written at all — never in the clear.
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- Where a caller's memory lives ---
# Unset means a file under runs/store, which is for development and not for
# callers. Set it and Postgres is used instead; a URL that does not connect is
# an error at startup rather than a quiet demotion back to files.
#   postgres://user:password@host:5432/eight80
# Apply migrations with: npm run db:migrate
DATABASE_URL=

# --- The recap email ---
# Unset means the recap is written to runs/mail instead of sent, which is for
# development. Both are required together: one without the other is a
# configuration error rather than a silent no-send.
RESEND_API_KEY=
RECAP_FROM_ADDRESS=hei@8and80.me

# Override for the recap's letterhead image. Leave it empty: by default the
# control plane serves it itself at PUBLIC_URL/mark.png, and that is the point.
# A remote image in an email tells whoever serves it the moment somebody opened
# their recap. Served from here that is a line in our own log we choose not to
# write; served from an image CDN it is a record on somebody else's account of
# when private accountability emails were read.
# With no PUBLIC_URL there is no image, and the letter is built to be whole
# without one — which is also what a recipient with images blocked sees.
RECAP_MARK_URL=

# --- Who the terms and the privacy page name as the controller ---
# Empty until somebody sets it, and the pages say so rather than inventing a
# company. A privacy policy naming a data controller that does not exist is
# worse than one admitting it is a draft.
COMPANY_NAME=
COMPANY_ORGNR=
COMPANY_ADDRESS=
SUPPORT_EMAIL=hei@8and80.me

# --- Payments, through Lemon Squeezy ---
# The hosted checkout for the subscription, from their dashboard. The price
# lives there and not here: a price in two places is a price that will
# eventually disagree with itself, and the one taking the money should win.
LEMONSQUEEZY_CHECKOUT_URL=
# The signing secret of the webhook you point at PUBLIC_URL/webhooks/lemonsqueezy.
# Without it every delivery is refused with a 401 — it fails closed on purpose.
LEMONSQUEEZY_WEBHOOK_SECRET=
# How long the free month is. The brand guide says a month and does not ask
# for a card, so 30 unless there is a reason.
TRIAL_DAYS=30

# --- The public sign-up page ---
# Off unless this is exactly "1". The form spends money on every submission
# and texts a stranger's phone, so opening it is a decision somebody makes on
# purpose rather than a side effect of a deploy. It needs DATABASE_URL,
# DATA_ENCRYPTION_KEY, PUBLIC_URL and the Twilio SMS block below; without the
# texts there is no way to prove a number, and without that the form is a way
# to have somebody rung every Tuesday by a voice they never asked for.
SIGNUP_OPEN=

# --- The one text after a missed call ---
# Unset means texts are written to runs/sms instead of sent. All three together
# or none: a half-configured sender means nobody gets the one message this
# product sends while the logs report it went out.
# A Norwegian number for Norwegian callers — a +1 ringing weekly gets filtered,
# and an alphanumeric sender ID cannot receive the reply that moves the call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- The voice platform ---
# One agent serves every caller: it holds the prompt, the voice and the
# turn-taking. What differs per person goes out as dynamic_variables at call
# time, which is why their Memory toggle stays off — the commitment history
# lives in our Postgres, not theirs.
SPEECHIFY_API_KEY=
SPEECHIFY_AGENT_ID=
# A second agent, holding the first-call prompt. A Speechify agent carries one
# static prompt, and a first call and a returning call are different calls —
# one agent branching on a variable inside its own instructions is how an
# introduction leaks into week six. Unset, first calls use the agent above.
SPEECHIFY_FIRST_CALL_AGENT_ID=
# The number the caller sees. Norwegian, for Norwegian callers: a +1 ringing
# weekly gets filtered, and the same number has to carry the missed-call text.
SPEECHIFY_CALLER_ID_NUMBER=
# Endpoint secret for conversation.completed / conversation.failed. Without it
# the receiver refuses every delivery rather than trusting unsigned ones.
# The signing secret from the agent's Channels → Webhook panel. It belongs to an
# AGENT, not to the account, so each agent has its own — list them separated by
# commas and a delivery signed by any of them is accepted. That is also how a
# rotation stays safe: add the new one, move the agent over, drop the old one,
# with no window where a finished call goes unrecorded.
SPEECHIFY_WEBHOOK_SECRET=
# Their API host. The paths are documented, the hostname is not.
SPEECHIFY_API_BASE=
# Optional request fields, each off until proven accepted by this account. A
# body carrying all of them came back "Request body is not valid JSON", which
# names no field — so they go back one at a time, and the failure log prints
# which keys were sent.
SPEECHIFY_SEND_VARIABLES=
SPEECHIFY_SEND_AMD=
SPEECHIFY_SEND_RINGING_TIMEOUT=
SPEECHIFY_SEND_LANGUAGE=
# Port for the webhook listener (npm run control). Behind TLS on a public
# hostname — the tunnel was fine for testing, but a URL that changes on restart
# is a webhook that silently stops working.
CONTROL_PORT=

# --- The reschedule link ---
# Where the page lives — the missed-call text points
# here. Unset means no link, which means no text at all: a message that only
# reports a missed call is a notification about a failure.
PUBLIC_URL=https://8and80.me

# --- Telephony provider (behind the telephony adapter) ---
# "telnyx" or "twilio". Telnyx is primary.
TELEPHONY_PROVIDER=
TELNYX_API_KEY=
# Call Control application / connection that routes media to our voice service.
TELNYX_CONNECTION_ID=
# Telnyx public key, for verifying inbound webhook signatures. Required —
# an unverified webhook endpoint can be made to place calls.
TELNYX_PUBLIC_KEY=

# --- Numbers ---
# The number we call FROM, E.164. For 0b this is a temporary test number and
# may be non-Norwegian. For production it is the one fixed +47 mobile number,
# never rotated, and it must match the vCard TEL value exactly.
OUTBOUND_CALLER_NUMBER=
# Destination for the stress test. Own number only. E.164.
STRESS_TEST_TARGET_NUMBER=

# --- Voice service ---
VOICE_SERVICE_PORT=
# Public wss:// URL of the voice service, given to the telephony provider as
# the media destination. Must be the DNS-only subdomain — NOT behind
# Cloudflare's proxy. See ARCHITECTURE.md.
VOICE_WS_PUBLIC_URL=https://voice.8and80.me

# --- Turn detection ---
# The single documented endpointing config value. Tunable without touching
# logic; the stress-test scores are the baseline for moving it. Higher means
# more patient. Default on a pause is always to wait.
ENDPOINTING_SENSITIVITY_MS=
# Active variant ids from SCRIPT.md, one per user. Stress test runs nothing.c.
SCRIPT_VARIANT_NOTHING=
SCRIPT_VARIANT_NEXT_ASK=
SCRIPT_VARIANT_CLOSE_Q=

# ─────────────────────────────────────────────────────────────────────────────
# Milestone 1 — scaffold, schema, auth        (documented, not yet used)
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth, self-hosted. Secret must be generated, never reused across envs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Public URL of the web app.
APP_URL=

# --- Encryption ---
# Reference/id of the master key in the secret manager. THE MASTER KEY ITSELF
# NEVER GOES IN AN ENV VAR, THE DATABASE, OR THIS REPO. Per-user data keys are
# wrapped by it and stored; the master key stays in the secret manager.
ENCRYPTION_MASTER_KEY_REF=

# ─────────────────────────────────────────────────────────────────────────────
# Milestone 2 — verification, onboarding      (documented, not yet used)
# ─────────────────────────────────────────────────────────────────────────────

# SMS sends use the same OUTBOUND_CALLER_NUMBER above. We do not use an
# alphanumeric sender id: it is one-way and would break missed-call replies.
# Display name written into the onboarding vCard. Externalised content, not a
# hardcoded string.
VCARD_DISPLAY_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Milestone 5 — post-call, recaps, escalation (documented, not yet used)
# ─────────────────────────────────────────────────────────────────────────────

# Larger post-call model. Vendor undecided; behind the model adapter.
POSTCALL_MODEL_PROVIDER=
POSTCALL_MODEL_API_KEY=
POSTCALL_MODEL_ID=

# Transactional email for recaps. Vendor undecided.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Safety escalation. Tier 1 (acute risk) pages a human immediately by both
# channels. Tier 2 goes to a daily digest. Never auto-actioned to the user.
ESCALATION_SMS_NUMBER=
ESCALATION_EMAIL=

# Transcript/summary retention in days. Default 90. A job must actually run.
DATA_RETENTION_DAYS=

# ─────────────────────────────────────────────────────────────────────────────
# Milestone 6 — capacity and billing          (documented, not yet used)
# ─────────────────────────────────────────────────────────────────────────────

# How many free users we can support concurrently. When reached, signup says so
# warmly and takes their number — it never fails and never silently queues.
FREE_CAPACITY_LIMIT=
# Call minutes per free user per week.
FREE_WEEKLY_MINUTE_LIMIT=

# Lemon Squeezy is configured further up, under "Payments". It used to be
# listed again here, which is worse than useless: dotenv takes the LAST value
# for a repeated key, so the empty one down here silently overwrote the one
# somebody had filled in above. `npm run preflight` now fails on a duplicate.

# ─────────────────────────────────────────────────────────────────────────────
# Twilio — documented fallback, and the quickest route to a first call
# ─────────────────────────────────────────────────────────────────────────────
# Set TELEPHONY_PROVIDER=twilio above to use these instead of the Telnyx keys.
# TwiML is sent inline with the dial, so Twilio never fetches anything from us —
# only VOICE_WS_PUBLIC_URL has to be reachable.
# On a trial account, outbound calls reach verified numbers only.
#
# The credentials are the same ones the SMS block above uses, and they are
# listed once, up there. They were listed twice until somebody noticed that
# dotenv takes the LAST value for a repeated key — so these empty lines were
# quietly overwriting the filled-in ones above.
